---
/**
 * Chat de triagem conversacional (estilo WhatsApp) — máquina de passos:
 * boasVindas → nome → perguntas[i] → telefone → veredito.
 * Vanilla TS no <script>; sem dependência nova.
 */
import type { QuizData } from '../data/quizzes/types';
import { site } from '../data/site';

interface Props { quiz: QuizData }
const { quiz } = Astro.props;

const iniciais = quiz.atendente.nome
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((palavra) => palavra[0])
  .join('')
  .toUpperCase();
---
<div class="chat-page">
  <div class="chat-card">
    <header class="chat-header">
      <div class="chat-avatar" aria-hidden="true">{iniciais}</div>
      <div class="chat-header-info">
        <div class="chat-header-nome">{quiz.atendente.nome}</div>
        <div class="chat-header-cargo">{quiz.atendente.cargo} · <span class="chat-online">online</span></div>
      </div>
    </header>

    <div class="chat-body" id="chat-body" aria-live="polite"></div>

    <form class="chat-form" id="chat-form" novalidate hidden>
      <!-- honeypot: oculto para humanos -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
      <input class="chat-input" id="chat-input" name="valor" autocomplete="off" required aria-label="Sua resposta" />
      <button type="submit" class="chat-send" aria-label="Enviar">➤</button>
    </form>
  </div>
</div>

<footer class="chat-page-footer">
  <p>{site.nomeBanca} · {site.oab}</p>
  <p>
    <a href="/lp/politica-de-privacidade/">Política de privacidade</a>
  </p>
  <p class="chat-page-disclaimer">
    Conteúdo informativo. Não substitui a orientação jurídica individual de um(a) advogado(a).
  </p>
</footer>

<script type="application/json" id="quiz-data" is:inline set:html={JSON.stringify(quiz)}></script>

<script>
  import type { QuizData, PerguntaQuiz, OpcaoResposta } from '../data/quizzes/types';
  import { avaliar, montarResumo, type Resposta } from '../lib/quiz';
  import { enviarLead, normalizarTelefone } from '../lib/enviarLead';
  import { trackLead, trackContact } from '../lib/tracking';

  const dataEl = document.getElementById('quiz-data');
  const quiz: QuizData = JSON.parse(dataEl?.textContent ?? '{}');

  const body = document.getElementById('chat-body') as HTMLDivElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const honeypot = form.querySelector('[name="website"]') as HTMLInputElement;

  const endpoint = import.meta.env.PUBLIC_LEADS_ENDPOINT as string | undefined;
  const whats = import.meta.env.PUBLIC_WHATSAPP_NUMERO as string | undefined;

  let nome = '';
  let telefone = '';
  let perguntaIndex = 0;
  let etapa: 'nome' | 'telefone' | null = null;
  const respostas: Resposta[] = [];

  function sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function scrollAoFim(): void {
    body.scrollTop = body.scrollHeight;
  }

  function addBolha(autor: 'atendente' | 'visitante', texto: string): void {
    const div = document.createElement('div');
    div.className = `bolha bolha-${autor}`;
    div.textContent = texto;
    body.appendChild(div);
    scrollAoFim();
  }

  function visitanteFala(texto: string): void {
    addBolha('visitante', texto);
  }

  /** Troca o placeholder {nome} pelo nome capturado; some limpo se ainda não houver nome. */
  function interpolarNome(texto: string): string {
    return nome
      ? texto.replace('{nome}', () => nome)
      : texto.replace('{nome}', '').replace(/\s{2,}/g, ' ').trim();
  }

  async function atendenteFala(textos: string[]): Promise<void> {
    for (const texto of textos) {
      const digitando = document.createElement('div');
      digitando.className = 'bolha bolha-atendente bolha-typing';
      digitando.innerHTML = '<span></span><span></span><span></span>';
      body.appendChild(digitando);
      scrollAoFim();
      await sleep(900);
      digitando.remove();
      addBolha('atendente', interpolarNome(texto));
      await sleep(250);
    }
  }

  function mostrarChips(pergunta: PerguntaQuiz, onEscolher: (opcao: OpcaoResposta) => void): void {
    const row = document.createElement('div');
    row.className = 'chip-row';
    for (const opcao of pergunta.opcoes) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.textContent = opcao.rotulo;
      btn.addEventListener('click', () => {
        row.remove();
        onEscolher(opcao);
      });
      row.appendChild(btn);
    }
    body.appendChild(row);
    scrollAoFim();
  }

  function mostrarInput(tipo: 'text' | 'tel', placeholder: string, novaEtapa: 'nome' | 'telefone'): void {
    input.type = tipo;
    input.placeholder = placeholder;
    input.autocomplete = tipo === 'tel' ? 'tel' : 'name';
    input.value = '';
    form.hidden = false;
    etapa = novaEtapa;
    requestAnimationFrame(() => input.focus());
  }

  function esconderInput(): void {
    form.hidden = true;
    etapa = null;
  }

  function mostrarBotaoWhats(resumo: string): void {
    const texto = `${quiz.mensagemWhatsPrefixo}\n${resumo}`;
    const a = document.createElement('a');
    a.className = 'chat-cta';
    a.href = `https://wa.me/${whats ?? ''}?text=${encodeURIComponent(texto)}`;
    a.target = '_blank';
    a.rel = 'noopener';
    a.textContent = quiz.aprovado.botaoWhats;
    a.addEventListener('click', () => trackContact());
    body.appendChild(a);
    scrollAoFim();
  }

  function mostrarLinkReprovado(): void {
    const a = document.createElement('a');
    a.className = 'chat-cta chat-cta-secundario';
    a.href = quiz.reprovado.linkLp;
    a.textContent = quiz.reprovado.rotuloLink;
    body.appendChild(a);
    scrollAoFim();
  }

  async function proximaPergunta(): Promise<void> {
    if (perguntaIndex >= quiz.perguntas.length) {
      await atendenteFala(quiz.perguntaTelefone);
      mostrarInput('tel', '(48) 9 0000-0000', 'telefone');
      return;
    }
    const pergunta = quiz.perguntas[perguntaIndex];
    await atendenteFala(pergunta.bolhas);
    mostrarChips(pergunta, (opcao) => {
      respostas.push({ pergunta, opcao });
      visitanteFala(opcao.rotulo);
      perguntaIndex += 1;
      void proximaPergunta();
    });
  }

  async function veredito(): Promise<void> {
    const { qualificado, duvidas } = avaliar(respostas);
    const resumo = montarResumo(quiz.tese, nome, respostas, duvidas);

    // Disparado sem await: enviarLead não tem timeout próprio, e rede ruim/hub
    // pendurado não pode segurar o veredito visual (bolhas + botão de WhatsApp).
    if (endpoint) {
      const campanha = qualificado ? quiz.slug : `${quiz.slug}-desqualificado`;
      void enviarLead(endpoint, {
        nome, telefone, campanha, mensagem: resumo, website: honeypot.value,
      // Pixel `Lead` só no qualificado: desqualificado entra no hub, mas não
      // ensina o algoritmo da Meta com lead ruim (decisão Eduardo 10/08).
      }).then((res) => { if (res.ok && qualificado) trackLead(); });
    }

    if (qualificado) {
      await atendenteFala(quiz.aprovado.bolhas);
      mostrarBotaoWhats(resumo);
    } else {
      await atendenteFala(quiz.reprovado.bolhas);
      mostrarLinkReprovado();
    }
  }

  async function aposNome(valor: string): Promise<void> {
    nome = valor;
    visitanteFala(nome);
    esconderInput();
    await proximaPergunta();
  }

  async function aposTelefone(valor: string): Promise<void> {
    visitanteFala(valor);
    const normalizado = normalizarTelefone(valor);
    if (!normalizado) {
      await atendenteFala(['Esse número não parece completo. Confere o DDD?']);
      mostrarInput('tel', '(48) 9 0000-0000', 'telefone');
      return;
    }
    telefone = normalizado;
    esconderInput();
    await veredito();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (honeypot.value) return; // bot: ignora silenciosamente
    const valor = input.value.trim();
    if (!valor) return;
    if (etapa === 'nome') void aposNome(valor);
    else if (etapa === 'telefone') void aposTelefone(valor);
  });

  async function iniciar(): Promise<void> {
    await atendenteFala(quiz.boasVindas);
    await atendenteFala([quiz.perguntaNome]);
    mostrarInput('text', 'Digite seu nome', 'nome');
  }

  void iniciar();
</script>

<style>
  .chat-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: var(--space-6) clamp(1rem, 4vw, 2rem);
  }
  .chat-card {
    width: 100%;
    max-width: 480px;
    height: 88vh;
    background: var(--cream-100);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: var(--bronze-600);
    color: var(--cream-100);
    flex-shrink: 0;
  }
  .chat-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bronze-900);
    color: var(--cream-100);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .chat-header-nome { font-family: var(--font-sans); font-weight: 600; font-size: 1rem; }
  .chat-header-cargo {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    opacity: 0.85;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .chat-online { display: inline-flex; align-items: center; gap: 4px; }
  .chat-online::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    display: inline-block;
  }

  .chat-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bolha {
    max-width: 82%;
    padding: 10px 14px;
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    white-space: pre-line;
  }
  .bolha-atendente {
    align-self: flex-start;
    background: var(--white);
    color: var(--text-primary);
    border-bottom-left-radius: 4px;
    box-shadow: var(--shadow-sm);
  }
  .bolha-visitante {
    align-self: flex-end;
    background: color-mix(in srgb, var(--bronze-300) 35%, var(--white));
    color: var(--text-primary);
    border-bottom-right-radius: 4px;
  }

  .bolha-typing { display: flex; gap: 4px; align-items: center; padding: 13px 16px; }
  .bolha-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bronze-400);
    animation: piscar 1.2s infinite ease-in-out;
  }
  .bolha-typing span:nth-child(2) { animation-delay: 0.2s; }
  .bolha-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes piscar { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }

  .chip-row { display: flex; flex-wrap: wrap; gap: 8px; align-self: flex-start; max-width: 100%; }
  .chip {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--bronze-700);
    background: var(--white);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-pill);
    padding: 9px 16px;
    cursor: pointer;
    transition: background 160ms, color 160ms;
  }
  .chip:hover { background: var(--bronze-600); color: var(--cream-100); border-color: var(--bronze-600); }

  .chat-cta {
    align-self: flex-start;
    display: inline-block;
    margin-top: 4px;
    padding: 12px 20px;
    border-radius: var(--radius-pill);
    background: var(--bronze-600);
    color: var(--cream-100);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    text-align: center;
  }
  .chat-cta-secundario {
    background: transparent;
    color: var(--bronze-600);
    border: 1px solid var(--bronze-600);
    text-decoration: underline;
  }

  .chat-form[hidden] { display: none; }
  .chat-form {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--border-soft);
    background: var(--white);
    flex-shrink: 0;
  }
  .chat-input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-pill);
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    background: var(--cream-100);
    color: var(--text-primary);
  }
  .chat-input:focus { outline: none; border-color: var(--bronze-600); }
  .chat-send {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: var(--bronze-600);
    color: var(--cream-100);
    cursor: pointer;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .chat-send:hover { background: var(--bronze-700); }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .chat-page-footer {
    max-width: 480px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem) var(--space-8);
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .chat-page-footer p { margin: 4px 0; }
  .chat-page-footer a { color: var(--bronze-600); text-decoration: underline; }
  .chat-page-disclaimer { opacity: 0.7; max-width: 42ch; margin: 8px auto 0; }

  @media (max-width: 768px) {
    .chat-page { padding: 0; }
    .chat-card { max-width: none; height: 100vh; height: 100dvh; border-radius: 0; }
  }
</style>
