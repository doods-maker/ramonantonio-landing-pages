---
/**
 * Chat de triagem conversacional (visual WhatsApp) — máquina de passos:
 * boasVindas → perguntas[i] (só clique) → telefone → veredito.
 * Vanilla TS no <script>; sem dependência nova.
 */
import type { QuizData } from '../data/quizzes/types';
import { site } from '../data/site';

interface Props { quiz: QuizData }
const { quiz } = Astro.props;

const iniciais = quiz.atendente.nome
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map((palavra) => palavra[0])
  .join('')
  .toUpperCase();
---
<div class="chat-page">
  <div class="chat-card">
    <header class="chat-header">
      <div class="chat-avatar" aria-hidden="true">{iniciais}</div>
      <div class="chat-header-info">
        <div class="chat-header-nome">{quiz.atendente.nome}</div>
        <div class="chat-header-cargo">{quiz.atendente.cargo} · <span class="chat-online">online</span></div>
      </div>
    </header>

    <div class="chat-body" id="chat-body" aria-live="polite"></div>

    <form class="chat-form" id="chat-form" novalidate hidden>
      <!-- honeypot: oculto para humanos -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
      <input class="chat-input" id="chat-input" name="valor" type="tel" autocomplete="tel" required aria-label="Seu WhatsApp com DDD" />
      <button type="submit" class="chat-send" aria-label="Enviar">➤</button>
    </form>
  </div>
</div>

<footer class="chat-page-footer">
  <p>{site.nomeBanca} · {site.oab}</p>
  <p>
    <a href="/lp/politica-de-privacidade/">Política de privacidade</a>
  </p>
  <p class="chat-page-disclaimer">
    Conteúdo informativo. Não substitui a orientação jurídica individual de um(a) advogado(a).
  </p>
</footer>

<script type="application/json" id="quiz-data" is:inline set:html={JSON.stringify(quiz)}></script>

<script>
  import type { QuizData, PerguntaQuiz, OpcaoResposta } from '../data/quizzes/types';
  import { avaliar, montarResumo, type Resposta } from '../lib/quiz';
  import { enviarLead, normalizarTelefone } from '../lib/enviarLead';
  import { trackLead, trackContact } from '../lib/tracking';

  const dataEl = document.getElementById('quiz-data');
  const quiz: QuizData = JSON.parse(dataEl?.textContent ?? '{}');

  const body = document.getElementById('chat-body') as HTMLDivElement;
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const honeypot = form.querySelector('[name="website"]') as HTMLInputElement;

  const endpoint = import.meta.env.PUBLIC_LEADS_ENDPOINT as string | undefined;
  const whats = import.meta.env.PUBLIC_WHATSAPP_NUMERO as string | undefined;
  const calcom = import.meta.env.PUBLIC_CALCOM_URL as string | undefined;

  let telefone = '';
  let perguntaIndex = 0;
  let aguardandoTelefone = false;
  const respostas: Resposta[] = [];

  function sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function scrollAoFim(): void {
    body.scrollTop = body.scrollHeight;
  }

  function addBolha(autor: 'atendente' | 'visitante', texto: string): void {
    const div = document.createElement('div');
    div.className = `bolha bolha-${autor}`;
    div.textContent = texto;
    body.appendChild(div);
    scrollAoFim();
  }

  function visitanteFala(texto: string): void {
    addBolha('visitante', texto);
  }

  async function atendenteFala(textos: string[]): Promise<void> {
    for (const texto of textos) {
      const digitando = document.createElement('div');
      digitando.className = 'bolha bolha-atendente bolha-typing';
      digitando.innerHTML = '<span></span><span></span><span></span>';
      body.appendChild(digitando);
      scrollAoFim();
      await sleep(900);
      digitando.remove();
      addBolha('atendente', texto);
      await sleep(250);
    }
  }

  function mostrarChips(pergunta: PerguntaQuiz, onEscolher: (opcao: OpcaoResposta) => void): void {
    const row = document.createElement('div');
    row.className = 'chip-row';
    for (const opcao of pergunta.opcoes) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.textContent = opcao.rotulo;
      btn.addEventListener('click', () => {
        row.remove();
        onEscolher(opcao);
      });
      row.appendChild(btn);
    }
    body.appendChild(row);
    scrollAoFim();
  }

  function mostrarInputTelefone(): void {
    input.placeholder = '(48) 9 0000-0000';
    input.value = '';
    form.hidden = false;
    aguardandoTelefone = true;
    requestAnimationFrame(() => input.focus());
  }

  function esconderInput(): void {
    form.hidden = true;
    aguardandoTelefone = false;
  }

  function mostrarBotaoWhats(resumo: string): void {
    const texto = `${quiz.mensagemWhatsPrefixo}\n${resumo}`;
    const a = document.createElement('a');
    a.className = 'chat-cta';
    a.href = `https://wa.me/${whats ?? ''}?text=${encodeURIComponent(texto)}`;
    a.target = '_blank';
    a.rel = 'noopener';
    a.textContent = quiz.aprovado.botaoWhats;
    a.addEventListener('click', () => trackContact());
    body.appendChild(a);
    mostrarLinkAgendamento();
    scrollAoFim();
  }

  // Cal.com (decisão D14, 16/08): o lead escolhe dia e horário sozinho.
  // Sem PUBLIC_CALCOM_URL o botão simplesmente não existe.
  function mostrarLinkAgendamento(): void {
    if (!calcom) return;
    const a = document.createElement('a');
    a.className = 'chat-cta chat-cta-secundario';
    a.href = calcom;
    a.target = '_blank';
    a.rel = 'noopener';
    a.textContent = 'Prefere já marcar um horário? Agendar conversa';
    body.appendChild(a);
  }

  function mostrarLinkReprovado(): void {
    const a = document.createElement('a');
    a.className = 'chat-cta chat-cta-secundario';
    a.href = quiz.reprovado.linkLp;
    a.textContent = quiz.reprovado.rotuloLink;
    body.appendChild(a);
    scrollAoFim();
  }

  async function proximaPergunta(): Promise<void> {
    if (perguntaIndex >= quiz.perguntas.length) {
      await atendenteFala(quiz.perguntaTelefone);
      mostrarInputTelefone();
      return;
    }
    const pergunta = quiz.perguntas[perguntaIndex];
    await atendenteFala(pergunta.bolhas);
    mostrarChips(pergunta, (opcao) => {
      respostas.push({ pergunta, opcao });
      visitanteFala(opcao.rotulo);
      perguntaIndex += 1;
      void proximaPergunta();
    });
  }

  async function veredito(): Promise<void> {
    const { qualificado, duvidas } = avaliar(respostas);
    const resumo = montarResumo(quiz.tese, '', respostas, duvidas);

    // Disparado sem await: enviarLead não tem timeout próprio, e rede ruim/hub
    // pendurado não pode segurar o veredito visual (bolhas + botão de WhatsApp).
    if (endpoint) {
      const campanha = qualificado ? quiz.slug : `${quiz.slug}-desqualificado`;
      const respostasPayload = respostas.map((r) => ({
        id: r.pergunta.id,
        pergunta: r.pergunta.rotuloResumo,
        resposta: r.opcao.rotulo,
        valor: r.opcao.valor,
        ...(r.opcao.reprova ? { reprova: true } : {}),
        ...(r.opcao.duvida ? { duvida: true } : {}),
      }));
      // Sem etapa de nome no fluxo (decisão Eduardo 10/08): o hub identifica
      // pelo telefone; o nome real vem na conversa do WhatsApp.
      void enviarLead(endpoint, {
        nome: 'Lead triagem', telefone, campanha, mensagem: resumo, website: honeypot.value,
        qualificado, duvidas, respostas: respostasPayload,
      // Pixel `Lead` só no qualificado: desqualificado entra no hub, mas não
      // ensina o algoritmo da Meta com lead ruim (decisão Eduardo 10/08).
      }).then((res) => { if (res.ok && qualificado) trackLead(); });
    }

    if (qualificado) {
      await atendenteFala(quiz.aprovado.bolhas);
      mostrarBotaoWhats(resumo);
    } else {
      await atendenteFala(quiz.reprovado.bolhas);
      mostrarLinkReprovado();
    }
  }

  async function aposTelefone(valor: string): Promise<void> {
    visitanteFala(valor);
    const normalizado = normalizarTelefone(valor);
    if (!normalizado) {
      await atendenteFala(['Esse número não parece completo. Confere o DDD?']);
      mostrarInputTelefone();
      return;
    }
    telefone = normalizado;
    esconderInput();
    await veredito();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (honeypot.value) return; // bot: ignora silenciosamente
    const valor = input.value.trim();
    if (!valor || !aguardandoTelefone) return;
    void aposTelefone(valor);
  });

  async function iniciar(): Promise<void> {
    await atendenteFala(quiz.boasVindas);
    await proximaPergunta();
  }

  void iniciar();
</script>

<style>
  /* Paleta WhatsApp (fixa, de propósito — não segue o tema bronze do site). */
  .chat-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: var(--space-6) clamp(1rem, 4vw, 2rem);
    background: #f0f2f5;
  }
  .chat-card {
    width: 100%;
    max-width: 480px;
    height: 88vh;
    background: #ece5dd;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #075e54;
    color: #fff;
    flex-shrink: 0;
  }
  .chat-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #128c7e;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-whats);
    font-weight: 600;
    font-size: 1.05rem;
    flex-shrink: 0;
  }
  .chat-header-nome { font-family: var(--font-whats); font-weight: 600; font-size: 1.02rem; }
  .chat-header-cargo {
    font-family: var(--font-whats);
    font-size: 0.78rem;
    opacity: 0.9;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .chat-online { display: inline-flex; align-items: center; gap: 4px; }
  .chat-online::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25d366;
    display: inline-block;
  }

  .chat-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bolha {
    max-width: 82%;
    padding: 8px 12px;
    border-radius: 10px;
    font-family: var(--font-whats);
    font-size: 0.92rem;
    line-height: 1.45;
    white-space: pre-line;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.12);
  }
  .bolha-atendente {
    align-self: flex-start;
    background: #fff;
    color: #111b21;
    border-top-left-radius: 2px;
  }
  .bolha-visitante {
    align-self: flex-end;
    background: #dcf8c6;
    color: #111b21;
    border-top-right-radius: 2px;
  }

  .bolha-typing { display: flex; gap: 4px; align-items: center; padding: 12px 14px; }
  .bolha-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8696a0;
    animation: piscar 1.2s infinite ease-in-out;
  }
  .bolha-typing span:nth-child(2) { animation-delay: 0.2s; }
  .bolha-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes piscar { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }

  .chip-row { display: flex; flex-wrap: wrap; gap: 8px; align-self: flex-start; max-width: 100%; padding: 2px 0 6px; }
  .chip {
    font-family: var(--font-whats);
    font-size: 0.9rem;
    color: #008069;
    background: #fff;
    border: 1px solid #d1d7db;
    border-radius: 999px;
    padding: 9px 16px;
    cursor: pointer;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
    transition: background 160ms, color 160ms;
  }
  .chip:hover, .chip:active { background: #008069; color: #fff; border-color: #008069; }

  .chat-cta {
    align-self: flex-start;
    display: inline-block;
    margin-top: 4px;
    padding: 13px 22px;
    border-radius: 999px;
    background: #25d366;
    color: #fff;
    font-family: var(--font-whats);
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
  }
  .chat-cta-secundario {
    background: #fff;
    color: #008069;
    border: 1px solid #008069;
    box-shadow: none;
  }

  .chat-form[hidden] { display: none; }
  .chat-form {
    display: flex;
    gap: 8px;
    padding: 10px 12px;
    background: #f0f2f5;
    flex-shrink: 0;
  }
  .chat-input {
    flex: 1;
    min-width: 0;
    border: none;
    border-radius: 999px;
    padding: 12px 16px;
    font-family: var(--font-whats);
    font-size: var(--text-base);
    background: #fff;
    color: #111b21;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
  }
  .chat-input:focus { outline: 2px solid #25d366; outline-offset: -1px; }
  .chat-send {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: #25d366;
    color: #fff;
    cursor: pointer;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .chat-send:hover { background: #128c7e; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .chat-page-footer {
    max-width: 480px;
    margin: 0 auto;
    padding: var(--space-4) clamp(1rem, 4vw, 2rem) var(--space-8);
    text-align: center;
    font-family: var(--font-whats);
    font-size: 0.75rem;
    color: #54656f;
    line-height: 1.6;
    background: #f0f2f5;
  }
  .chat-page-footer p { margin: 4px 0; }
  .chat-page-footer a { color: #008069; text-decoration: underline; }
  .chat-page-disclaimer { opacity: 0.8; max-width: 42ch; margin: 8px auto 0; }

  @media (max-width: 768px) {
    .chat-page { padding: 0; }
    .chat-card { max-width: none; height: 100vh; height: 100dvh; border-radius: 0; }
  }
</style>

<style is:global>
  /* WhatsApp usa a fonte do sistema — o chat segue junto pra parecer nativo. */
  :root { --font-whats: -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; }
  body:has(.chat-page) { background: #f0f2f5; margin: 0; }
</style>
